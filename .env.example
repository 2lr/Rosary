# Secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-please-use-a-32-byte-random-hex-string

# Database.
# Leave empty to use a local SQLite file at ./data/rosary.db (zero setup).
# For production, point it at a Postgres instance, e.g.
#   DATABASE_URL=postgres://user:password@host:5432/rosary?sslmode=require
DATABASE_URL=
